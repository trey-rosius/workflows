{
  "Comment": "This workflow manages the Educloud course generation pipeline, transcribing, translating, segmenting syllabus, and generating learning assets.",
  "StartAt": "StartAsyncInvoke",
  "QueryLanguage": "JSONata",
  "States": {
    "StartAsyncInvoke": {
      "Type": "Task",
      "Arguments": {
        "ModelId": "amazon.nova-2-multimodal-embeddings-v1:0",
        "ModelInput": {
          "taskType": "SEGMENTED_EMBEDDING",
          "segmentedEmbeddingParams": {
            "embeddingDimension": 1024,
            "embeddingPurpose": "GENERIC_INDEX",
            "video": {
              "format": "mp4",
              "embeddingMode": "AUDIO_VIDEO_COMBINED",
              "source": {
                "s3Location": {
                  "uri": "{% $states.input.mediaFileUri %}"
                }
              },
              "segmentationConfig": {
                "durationSeconds": 5
              }
            }
          }
        },
        "OutputDataConfig": {
          "S3OutputDataConfig": {
            "S3Uri": "{% $states.input.mediaBucket %}"
          }
        }
      },
      "Resource": "arn:aws:states:::aws-sdk:bedrockruntime:startAsyncInvoke",
      "Output": "{% $merge([$states.result, $states.input]) %}",
      "Next": "WaitEmbeddings"
    },
    "WaitEmbeddings": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "GetAsyncInvoke"
    },
    "GetAsyncInvoke": {
      "Type": "Task",
      "Arguments": {
        "InvocationArn": "{% $states.input.InvocationArn %}"
      },
      "Resource": "arn:aws:states:::aws-sdk:bedrockruntime:getAsyncInvoke",
      "Next": "ChoiceEmbeddings"
    },
    "ChoiceEmbeddings": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "SaveEmbeddings",
          "Condition": "{% $states.input.Status = \"Completed\" %}"
        },
        {
          "Next": "Fail",
          "Condition": "{% $states.input.Status = \"Failed\" %}"
        }
      ],
      "Default": "WaitEmbeddings"
    },
    "SaveEmbeddings": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${FUNCTION_ARN}",
        "Payload": {
          "mediaFileUri": "{% $states.context.Execution.Input.mediaFileUri %}",
          "S3Uri": "{% $states.input.OutputDataConfig.S3OutputDataConfig.S3Uri %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "StartTranscribe"
    },
    "StartTranscribe": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${TRANSCRIBE_FUNCTION_ARN}",
        "Payload": {
          "mediaFileUri": "{% $states.context.Execution.Input.mediaFileUri %}",
          "action": "start"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "WaitTranscribe"
    },
    "WaitTranscribe": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "GetTranscribeStatus"
    },
    "GetTranscribeStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${TRANSCRIBE_FUNCTION_ARN}",
        "Payload": {
          "mediaFileUri": "{% $states.context.Execution.Input.mediaFileUri %}",
          "action": "status"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "ChoiceTranscribe"
    },
    "ChoiceTranscribe": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "AutoTranslateTranscript",
          "Condition": "{% $states.input.status = \"COMPLETED\" %}"
        }
      ],
      "Default": "WaitTranscribe"
    },
    "AutoTranslateTranscript": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${TRANSLATE_FUNCTION_ARN}",
        "Payload": {
          "mediaFileUri": "{% $states.context.Execution.Input.mediaFileUri %}",
          "transcriptFileUri": "{% $states.input.transcriptFileUri %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "SegmentSyllabus"
    },
    "SegmentSyllabus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${SEGMENT_SYLLABUS_FUNCTION_ARN}",
        "Payload": {
          "mediaFileUri": "{% $states.context.Execution.Input.mediaFileUri %}",
          "transcriptFileUri": "{% $states.input.transcriptFileUri %}",
          "transcriptText": "{% $states.input.transcriptText %}",
          "translatedTranscripts": "{% $states.input.translatedTranscripts %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "ParallelGen"
    },
    "ParallelGen": {
      "Type": "Parallel",
      "Next": "SaveDraft",
      "Output": "{% $states.result %}",
      "Branches": [
        {
          "StartAt": "GenerateGlobalAssets",
          "States": {
            "GenerateGlobalAssets": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Output": "{% $merge([$states.input, $states.result.Payload]) %}",
              "Arguments": {
                "FunctionName": "${GENERATE_ASSETS_FUNCTION_ARN}",
                "Payload": {
                  "mediaFileUri": "{% $states.input.mediaFileUri %}",
                  "transcriptFileUri": "{% $states.input.transcriptFileUri %}"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 6,
                  "BackoffRate": 2
                },
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 5,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "Next": "GlobalAssetsFallback"
                }
              ],
              "End": true
            },
            "GlobalAssetsFallback": {
              "Type": "Pass",
              "Output": "{% $merge([$states.input, { \"summary\": \"(Course summary temporarily unavailable)\", \"qa\": \"\", \"flashcards\": \"\", \"keyTakeaways\": \"\", \"translations\": [], \"localized\": [] }]) %}",
              "End": true
            }
          }
        },
        {
          "StartAt": "ProcessLessonsMap",
          "States": {
            "ProcessLessonsMap": {
              "Type": "Map",
              "Items": "{% $states.input.lessons %}",
              "ItemSelector": {
                "lesson": "{% $states.context.Map.Item.Value %}",
                "index": "{% $states.context.Map.Item.Index %}",
                "mediaFileUri": "{% $states.input.mediaFileUri %}",
                "transcriptFileUri": "{% $states.input.transcriptFileUri %}"
              },
              "ItemProcessor": {
                "ProcessorConfig": {
                  "Mode": "INLINE"
                },
                "StartAt": "SliceSegment",
                "States": {
                  "SliceSegment": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::lambda:invoke",
                    "Output": "{% $merge([$states.input, $states.result.Payload]) %}",
                    "Arguments": {
                      "FunctionName": "${SLICE_SEGMENT_FUNCTION_ARN}",
                      "Payload": {
                        "mediaFileUri": "{% $states.input.mediaFileUri %}",
                        "lesson": "{% $states.input.lesson %}",
                        "index": "{% $states.input.index %}"
                      }
                    },
                    "Retry": [
                      {
                        "ErrorEquals": [
                          "Lambda.ServiceException",
                          "Lambda.AWSLambdaException",
                          "Lambda.SdkClientException",
                          "Lambda.TooManyRequestsException"
                        ],
                        "IntervalSeconds": 2,
                        "MaxAttempts": 6,
                        "BackoffRate": 2
                      }
                    ],
                    "Next": "GenerateLessonAssets"
                  },
                  "GenerateLessonAssets": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::lambda:invoke",
                    "Output": "{% $states.result.Payload %}",
                    "Arguments": {
                      "FunctionName": "${GENERATE_ASSETS_FUNCTION_ARN}",
                      "Payload": {
                        "mediaFileUri": "{% $states.input.mediaFileUri %}",
                        "transcriptFileUri": "{% $states.input.transcriptFileUri %}",
                        "lesson": "{% $states.input.lesson %}"
                      }
                    },
                    "Retry": [
                      {
                        "ErrorEquals": [
                          "Lambda.ServiceException",
                          "Lambda.AWSLambdaException",
                          "Lambda.SdkClientException",
                          "Lambda.TooManyRequestsException"
                        ],
                        "IntervalSeconds": 2,
                        "MaxAttempts": 6,
                        "BackoffRate": 2
                      },
                      {
                        "ErrorEquals": [
                          "States.ALL"
                        ],
                        "IntervalSeconds": 5,
                        "MaxAttempts": 3,
                        "BackoffRate": 2
                      }
                    ],
                    "Catch": [
                      {
                        "ErrorEquals": ["States.ALL"],
                        "Next": "LessonAssetsFallback"
                      }
                    ],
                    "End": true
                  },
                  "LessonAssetsFallback": {
                    "Type": "Pass",
                    "Output": "{% { \"lesson\": $merge([$states.input.lesson, { \"summary\": \"(Summary temporarily unavailable)\", \"qa\": \"\", \"flashcards\": \"\", \"keyTakeaways\": \"\" }]) } %}",
                    "End": true
                  }
                }
              },
              "End": true
            }
          }
        }
      ]
    },
    "SaveDraft": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${SAVE_DRAFT_FUNCTION_ARN}",
        "Payload": {
          "mediaFileUri": "{% $states.context.Execution.Input.mediaFileUri %}",
          "title": "{% $states.input[0].title %}",
          "description": "{% $states.input[0].description %}",
          "global_assets": "{% $states.input[0] %}",
          "lessons": "{% $states.input[1] %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Success"
    },
    "Fail": {
      "Type": "Fail"
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}
